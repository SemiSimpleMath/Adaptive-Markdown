#!/bin/sh
# AM pre-commit: when iframe-host.html or index.html is staged, run the
# inline-script syntax check. This catches the </script>-in-comment trap
# (a JS comment containing literal </script> terminates the parent <script>
# at the comment, breaking the runtime in ways that surface as confusing
# downstream regressions). See scripts/check_inline_scripts.py.
#
# This hook is wired automatically by start.py via `git config
# core.hooksPath .githooks` on first run. To bypass for one commit:
# git commit --no-verify (use sparingly — this exists because the trap
# has recurred 5+ times).
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if printf '%s\n' "$staged" | grep -qE '^(iframe-host|index)\.html$'; then
    echo "[pre-commit] viewer HTML staged — running inline-script check..."
    if ! python scripts/check_inline_scripts.py; then
        echo ""
        echo "[pre-commit] check_inline_scripts.py FAILED — commit blocked."
        echo "Fix the issues above, or use --no-verify to bypass."
        exit 1
    fi
fi
