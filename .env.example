# Adaptive Markdown local configuration
#
# Copy this file to `.env`, then uncomment and edit one provider block.
# Shell environment variables still win over values in `.env`.

# ---- Claude Agent SDK -------------------------------------------------------
# AGENT_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-4-5-20251001
# MAX_BUDGET_USD=1.0

# ---- Codex CLI --------------------------------------------------------------
# AGENT_PROVIDER=codex
# CODEX_AUTH_MODE=api-key
# OPENAI_API_KEY=sk-...
# CODEX_COMMAND=C:\Users\semis\AppData\Local\OpenAI\Codex\bin\codex.exe
# API-key mode can use explicit API model ids.
# For ChatGPT-account auth, use CODEX_AUTH_MODE=chatgpt and CODEX_MODEL=default.
# CODEX_FAST_MODEL=codex-mini-latest
# CODEX_MODEL=codex-mini-latest
# CODEX_MODELS=codex-mini-latest,default,gpt-5.2-codex,gpt-5.4-mini,gpt-5.3-codex
# CODEX_SANDBOX=workspace-write
# CODEX_APPROVAL_POLICY=never

# ---- Server -----------------------------------------------------------------
# PORT=8090
