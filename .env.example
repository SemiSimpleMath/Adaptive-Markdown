# Adaptive Markdown local configuration
#
# Copy this file to `.env`, then uncomment the keys for the provider(s) you
# want to use. Pick the runtime at launch time with `python start.py --claude`
# or `python start.py --codex` — the flag is the only thing that decides which
# runtime reads these values. You can keep both blocks populated and toggle.
#
# Shell environment variables always win over values in this file.

# ---- Claude Agent SDK (--claude) -------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-4-5-20251001
# MAX_BUDGET_USD=1.0

# ---- Codex CLI (--codex) ---------------------------------------------------
# Path to the codex binary. Only required if `codex` isn't on PATH —
# typically needed on Windows; macOS / Linux installers usually put codex
# on PATH. Pick the line that matches your OS:
# CODEX_COMMAND=C:\Users\you\AppData\Local\OpenAI\Codex\bin\codex.exe   # Windows
# CODEX_COMMAND=/Users/you/.local/bin/codex                              # macOS / Linux
#
# Auth: `api-key` reads OPENAI_API_KEY; `chatgpt` uses Codex's own account
# auth (`codex auth login`). Auto-detects from presence of OPENAI_API_KEY
# if unset, but setting it explicitly avoids surprises.
# CODEX_AUTH_MODE=chatgpt
# OPENAI_API_KEY=sk-...
#
# Model: `default` uses your Codex account's default and is the safest
# pick for ChatGPT-account auth. API-key mode can name an explicit model.
# CODEX_MODEL=default
# CODEX_FAST_MODEL=codex-mini-latest
# CODEX_MODELS=default,gpt-5.4-mini,gpt-5.3-codex,gpt-5.2-codex,codex-mini-latest
#
# Sandbox + approvals — leave defaults unless you know you want to change them.
# CODEX_SANDBOX=workspace-write
# CODEX_APPROVAL_POLICY=never

# ---- Server -----------------------------------------------------------------
# PORT=8090
