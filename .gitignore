# Local-only notes
POSITIONING.md
STRATEGY.md
TODO.md
.env

# Build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
node_modules/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor state
.vscode/
.idea/
*.swp
*~

# Runtime / generated state
screenshots/
*.html.bak
*.id-aliases.json
.am-provider

# Doc-as-folder layout: docs/<slug>/ — only the ship-with examples
# may land in git, and even within those, only baseline.md + optional
# original.<ext> + assets/ are tracked. current.md (working copy), snaps/
# (pre-edit captures), and patches/ (legacy, soon-removed) stay local.
docs/*
!docs/intro/
!docs/paper/
!docs/textbook/
!docs/help/
!docs/plot-test/
!docs/csv-test/
docs/*/current.md
docs/*/snaps/
docs/*/patches/
# Pending-changes sidecar: per-reader transient state (proposed edits the
# reader hasn't accepted yet). Same gitignore policy as current.md /
# snaps/ — these are not part of the shipped example docs.
docs/*/pending.json
# Asset drops land at docs/<slug>/assets/. By default they stay local —
# add specific files with `git add -f docs/<slug>/assets/<file>` if you
# want to ship an asset with one of the example docs.
docs/*/assets/

# Components: reusable snippets the agent can save + insert anywhere.
# User-saved components stay local. A small set of demo components
# ship with the repo so first-run users can "insert the unit circle"
# without having to save one first.
components/*
!components/unit-circle.md
!components/dark-mode-toggle.md
!components/clock.md

# Local scratch
scratch folder/

# Sample data files dropped at the repo root while testing CSV / XLSX
# figure imports (iris.csv, etc.). Real data ships inside
# docs/<slug>/assets/, so a root-level .csv/.xlsx is always scratch.
# Use `git add -f` if you ever want to track one.
/*.csv
/*.xlsx

# Saved "keeper" doc versions — agent outputs worth holding onto outside
# of .history/'s autosave churn. Local-only by convention.
keepers/

# Test suite — scripts ship with the repo (every contributor benefits
# from the same regression coverage). Only the artifact dirs stay
# local: debug captures from real agent runs, pytest cache, pycache.
tests/__pycache__/
tests/_haiku_capture/
tests/.pytest_cache/

# Local-only helpers (not part of the published artifact). Pattern is
# `scripts/*` (not `scripts/`) so per-file allow-rules below work —
# git won't honor `!scripts/foo` if the parent directory itself is
# excluded.
convert.py
scripts/*
# Exception: regression guards that protect EVERY contributor from a
# recurring bug class belong in the repo even though most of scripts/
# is local. List specific allow-rules here as they're needed.
!scripts/check_inline_scripts.py
!scripts/check_forbidden_words.py
